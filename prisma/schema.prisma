datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Plot {
  id              String   @id // Unguessable short ID (nanoid) e.g., "m8x2k4p9q1"
  title           String
  status          String   @default("AVAILABLE") // AVAILABLE, PENDING, SOLD
  priceType       String   @default("FIXED") // FIXED, CONTACT_AGENT
  priceKes        Float?
  sizePreset      String   // "50x100", "40x80", "100x100", "ACRES", "HECTARES", "SQM", "CUSTOM"
  sizeCustomValue String?  // e.g. "0.5", "2.5", "100x150 ft"
  zoning          String?  // Residential, Agricultural, Commercial, Mixed
  roadAccess      String?  // Tarmac, All-weather gravel, Dirt road, None
  waterSource     String?  // Borehole, Piped county water, Natural stream, None
  electricity     String?  // On-site, Nearby (<200m), Off-grid
  description     String?
  latitude        Float
  longitude       Float
  photos          String   // JSON string of photo URLs/paths
  videoUrl        String?  // Video URL/path
  customAttributes String? // JSON string of custom key-value features
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  saleRecord      SaleRecord?
}

model SaleRecord {
  id              String               @id @default(cuid())
  plotId          String               @unique
  plot            Plot                 @relation(fields: [plotId], references: [id], onDelete: Cascade)
  buyerName         String
  buyerPhone        String
  buyerNationalId   String?              // National ID or KRA PIN for conveyancing
  buyerCustomFields String?              // JSON string of custom key-value buyer details (e.g. Next of Kin, Advocate, etc.)
  agreedPriceKes    Float
  paymentType     String               @default("LUMP_SUM") // LUMP_SUM or INSTALLMENT
  depositKes      Float                @default(0)
  balanceKes      Float                @default(0)
  nextDueDate     DateTime?
  titleStatus     String               @default("DEPOSIT_PAID") 
  // DEPOSIT_PAID -> AGREEMENT_SIGNED -> BALANCE_CLEARED -> LCB_CONSENT -> TITLE_ISSUED
  notes           String?
  closedAt        DateTime             @default(now())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  installments    PaymentInstallment[]
  review          BuyerReview?
}

model PaymentInstallment {
  id           String     @id @default(cuid())
  saleRecordId String
  saleRecord   SaleRecord @relation(fields: [saleRecordId], references: [id], onDelete: Cascade)
  amountKes    Float
  paymentDate  DateTime   @default(now())
  reference    String?    // e.g., M-Pesa transaction code or bank ref
  notes        String?
  createdAt    DateTime   @default(now())
}

model BuyerReview {
  id           String     @id @default(cuid())
  saleRecordId String     @unique
  saleRecord   SaleRecord @relation(fields: [saleRecordId], references: [id], onDelete: Cascade)
  buyerName    String
  rating       Int        @default(5)
  comment      String
  isPublished  Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

model AgentProfile {
  id             String   @id @default(cuid())
  agentName      String   @default("Land Sales Specialist")
  email          String   @unique @default("agent@example.com")
  passwordHash   String?
  whatsappNumber String   @default("+254700000000")
  customGreeting String?  @default("Hi! I'm inquiring about [Plot Title]. Is it still available?")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
