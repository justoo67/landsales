datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Plot {
  id               String       @id // Unguessable short ID (nanoid) e.g., "m8x2k4p9q1"
  agentId          String
  agent            AgentProfile @relation(fields: [agentId], references: [id], onDelete: Restrict)
  title            String
  status           String       @default("AVAILABLE") // AVAILABLE, PENDING, SOLD
  priceType        String       @default("FIXED") // FIXED, CONTACT_AGENT
  priceKes         Decimal?     @db.Decimal(14, 2)
  sizePreset       String // "50x100", "40x80", "100x100", "ACRES", "HECTARES", "SQM", "CUSTOM"
  sizeCustomValue  String? // e.g. "0.5", "2.5", "100x150 ft"
  county           String?
  ward             String?
  locationName     String?
  zoning           String? // Residential, Agricultural, Commercial, Mixed
  roadAccess       String? // Tarmac, All-weather gravel, Dirt road, None
  waterSource      String? // Borehole, Piped county water, Natural stream, None
  electricity      String? // On-site, Nearby (<200m), Off-grid
  description      String?
  latitude         Float
  longitude        Float
  photos           String // JSON string of photo URLs/paths
  videoUrl         String? // Video URL/path
  customAttributes String? // JSON string of custom key-value features
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime? // Soft delete; payment history must survive
  saleRecord       SaleRecord?
  leads            Lead[]
  activities       Activity[]
  tasks            Task[]
  visits           SiteVisit[]
  documents        Document[]

  @@index([agentId, deletedAt, status])
}

model SaleRecord {
  id                String               @id @default(cuid())
  plotId            String               @unique
  plot              Plot                 @relation(fields: [plotId], references: [id], onDelete: Restrict)
  buyerName         String
  buyerPhone        String
  buyerNationalId   String? // National ID or KRA PIN for conveyancing
  buyerCustomFields String? // JSON string of custom key-value buyer details (e.g. Next of Kin, Advocate, etc.)
  agreedPriceKes    Decimal              @db.Decimal(14, 2)
  paymentType       String               @default("LUMP_SUM") // LUMP_SUM or INSTALLMENT
  depositKes        Decimal              @default(0) @db.Decimal(14, 2)
  balanceKes        Decimal              @default(0) @db.Decimal(14, 2)
  nextDueDate       DateTime?
  titleStatus       String               @default("DEPOSIT_PAID")
  // DEPOSIT_PAID -> AGREEMENT_SIGNED -> BALANCE_CLEARED -> LCB_CONSENT -> TITLE_ISSUED
  notes             String?
  closedAt          DateTime             @default(now())
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  installments      PaymentInstallment[]
  review            BuyerReview?
  lead              Lead?
  activities        Activity[]
  tasks             Task[]
  documents         Document[]
  commission        Commission?
}

model PaymentInstallment {
  id           String     @id @default(cuid())
  saleRecordId String
  saleRecord   SaleRecord @relation(fields: [saleRecordId], references: [id], onDelete: Cascade)
  amountKes    Decimal    @db.Decimal(14, 2)
  paymentDate  DateTime   @default(now())
  method       String     @default("MPESA") // MPESA|BANK|CASH|CHEQUE
  reference    String? // e.g., M-Pesa transaction code or bank ref
  receiptUrl   String? // uploaded receipt image/PDF
  notes        String?
  createdAt    DateTime   @default(now())
}

model BuyerReview {
  id           String     @id @default(cuid())
  saleRecordId String     @unique
  saleRecord   SaleRecord @relation(fields: [saleRecordId], references: [id], onDelete: Cascade)
  buyerName    String
  rating       Int        @default(5)
  comment      String
  isPublished  Boolean    @default(true)
  createdAt    DateTime   @default(now())
}

model AgentProfile {
  id             String       @id @default(cuid())
  agentName      String       @default("Land Sales Specialist")
  email          String       @unique
  passwordHash   String?
  whatsappNumber String       @default("+254700000000")
  customGreeting String?      @default("Hi! I'm inquiring about [Plot Title]. Is it still available?")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  plots          Plot[]
  contacts       Contact[]
  leads          Lead[]
  activities     Activity[]
  tasks          Task[]
  visits         SiteVisit[]
  documents      Document[]
  comparables    Comparable[]
}

model Contact {
  id         String       @id @default(cuid())
  agentId    String
  agent      AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name       String
  phone      String // normalised E.164, dedupe key per agent
  altPhone   String?
  email      String?
  source     String       @default("FIELD") // WHATSAPP|REFERRAL|WALK_IN|SIGN|SOCIAL|REPEAT|INQUIRY|FIELD
  tags       String[]
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  leads      Lead[]
  tasks      Task[]
  activities Activity[]
  documents  Document[]

  @@unique([agentId, phone])
  @@index([agentId, name])
}

model Lead {
  id           String       @id @default(cuid())
  agentId      String
  agent        AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  plotId       String?
  plot         Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)
  stage        String       @default("INQUIRY")
  // INQUIRY|CONTACTED|SITE_VISIT|OFFER|DEPOSIT|CLOSED|LOST
  index        Int          @default(0)
  source       String       @default("FIELD")
  budgetMinKes Decimal?     @db.Decimal(14, 2)
  budgetMaxKes Decimal?     @db.Decimal(14, 2)
  lostReason   String?
  nextActionAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  saleId       String?      @unique
  sale         SaleRecord?  @relation(fields: [saleId], references: [id], onDelete: SetNull)
  tasks        Task[]
  activities   Activity[]
  visits       SiteVisit[]

  @@index([agentId, stage, index])
  @@index([agentId, nextActionAt])
  @@index([contactId])
  @@index([plotId])
}

model Activity {
  id        String       @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type      String
  // INQUIRY|LEAD_CREATED|STAGE_CHANGED|NOTE|CALL|WHATSAPP|PAYMENT|DOCUMENT|STATUS
  body      String?
  metadata  Json?
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  plotId    String?
  plot      Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)
  saleId    String?
  sale      SaleRecord?  @relation(fields: [saleId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())

  @@index([agentId, createdAt])
  @@index([leadId, createdAt])
  @@index([contactId, createdAt])
}

model Task {
  id        String       @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String
  type      String       @default("FOLLOW_UP") // CALL|WHATSAPP|SMS|SITE_VISIT|DOCUMENT|PAYMENT|FOLLOW_UP
  dueAt     DateTime
  doneAt    DateTime?
  priority  String       @default("NORMAL") // LOW|NORMAL|HIGH
  notes     String?
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  leadId    String?
  lead      Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  plotId    String?
  plot      Plot?        @relation(fields: [plotId], references: [id], onDelete: Cascade)
  saleId    String?
  sale      SaleRecord?  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  visit     SiteVisit?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([agentId, doneAt, dueAt])
  @@index([leadId, doneAt])
  @@index([plotId, doneAt])
}

model SiteVisit {
  id          String       @id @default(cuid())
  agentId     String
  agent       AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  plotId      String?
  plot        Plot?        @relation(fields: [plotId], references: [id], onDelete: SetNull)
  scheduledAt DateTime
  status      String       @default("SCHEDULED") // SCHEDULED|COMPLETED|NO_SHOW|CANCELLED
  feedback    String?
  rating      Int?
  taskId      String?      @unique
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([agentId, scheduledAt, status])
  @@index([leadId, scheduledAt])
  @@index([plotId])
}

model Document {
  id        String       @id @default(cuid())
  agentId   String
  agent     AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  kind      String // TITLE_DEED|AGREEMENT|RECEIPT|ID_COPY|MAP|SURVEY|CONSENT|OTHER
  name      String
  url       String
  key       String?
  mimeType  String?
  sizeBytes Int?
  plotId    String?
  plot      Plot?        @relation(fields: [plotId], references: [id], onDelete: Cascade)
  saleId    String?
  sale      SaleRecord?  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([agentId, createdAt])
  @@index([plotId, createdAt])
  @@index([saleId, createdAt])
  @@index([contactId, createdAt])
}

model Comparable {
  id           String       @id @default(cuid())
  agentId      String
  agent        AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  county       String
  ward         String?
  locationName String
  latitude     Float?
  longitude    Float?
  sizeAcres    Decimal      @db.Decimal(10, 4)
  priceKes     Decimal      @db.Decimal(14, 2)
  pricePerAcre Decimal      @db.Decimal(14, 2) // computed on write
  kind         String       @default("SALE") // SALE|LISTING
  source       String       @default("AGENT") // AGENT|PORTAL|PUBLIC_RECORD|HEARD
  sourceUrl    String?
  observedAt   DateTime     @default(now())
  verified     Boolean      @default(false)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([agentId, county, ward, observedAt])
  @@index([agentId, observedAt])
}

model Commission {
  id          String     @id @default(cuid())
  saleId      String     @unique
  sale        SaleRecord @relation(fields: [saleId], references: [id], onDelete: Cascade)
  basis       String     @default("PERCENT") // PERCENT|FIXED
  ratePercent Decimal?   @db.Decimal(5, 2)
  amountKes   Decimal    @db.Decimal(14, 2)
  status      String     @default("PENDING") // PENDING|INVOICED|PARTIAL|PAID
  dueDate     DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}
