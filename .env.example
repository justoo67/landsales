# ==============================================================================
# PlotPilot (LandSales) Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# In production on Vercel, use a managed PostgreSQL service:
# - Neon (recommended): https://neon.tech
# - Supabase: https://supabase.com
# - Vercel Postgres: https://vercel.com/storage/postgres
#
# DATABASE_URL: The connection string (pooled connection if using serverless pooler)
# DIRECT_URL: Direct/unpooled connection string (required by Prisma for migrations on Neon/Supabase)
# For standard PostgreSQL (non-pooled), both DATABASE_URL and DIRECT_URL can be identical.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION URL
# ------------------------------------------------------------------------------
# In production: Your live Vercel URL or custom domain (e.g. https://plots.yourdomain.com or https://project.vercel.app)
# In development: http://localhost:3000
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (For "Continue with Google" sign-in)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials:
# Authorized JavaScript origin: https://your-domain.vercel.app
# Authorized redirect URI:       https://your-domain.vercel.app/api/auth/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. AGENT ACCESS RESTRICTION
# ------------------------------------------------------------------------------
# Specify the authorized Google email address permitted to log in to the agent dashboard.
# Supports a single email or comma-separated list (e.g., "agent1@gmail.com, agent2@company.com")
ALLOWED_AGENT_EMAIL="your-google-email@gmail.com"

# ------------------------------------------------------------------------------
# 5. SESSION SECURITY
# ------------------------------------------------------------------------------
# A secure, random 32+ character secret string for signing JWT session cookies.
# Generate via: openssl rand -base64 32
JWT_SECRET="generate-a-secure-random-32-char-string-for-prod"
