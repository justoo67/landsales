# ==============================================================================
# PlotPilot (LandSales) Environment Configuration
#
# Copy to .env and fill in. Variables marked [PRODUCTION REQUIRED] cause the app
# to fail closed (refuse to sign in) when missing in a production build.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL) — [PRODUCTION REQUIRED]
# ------------------------------------------------------------------------------
# Neon, Supabase, or any managed Postgres.
# DATABASE_URL: pooled connection (serverless-friendly)
# DIRECT_URL:   direct/unpooled connection, used by `prisma migrate`
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. APPLICATION URL — [PRODUCTION REQUIRED]
# ------------------------------------------------------------------------------
# Used for Open Graph image URLs and the Google OAuth redirect.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 (optional — password sign-in works without it)
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. AGENT ACCESS RESTRICTION — [PRODUCTION REQUIRED]
# ------------------------------------------------------------------------------
# Only these addresses may sign in or register. Comma- or newline-separated.
# Empty means "allow anyone" in development and "allow nobody" in production.
ALLOWED_AGENT_EMAIL="agent@example.com"

# ------------------------------------------------------------------------------
# 5. SESSION SECURITY — [PRODUCTION REQUIRED]
# ------------------------------------------------------------------------------
# 32+ characters. Generate with: openssl rand -base64 32
# In production the app refuses to sign sessions if this is missing.
JWT_SECRET=""

# ------------------------------------------------------------------------------
# 6. MEDIA STORAGE (Cloudflare R2, optional)
# ------------------------------------------------------------------------------
# Without these, uploads fall back to local disk under /public/uploads.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="plotpilot-media"
NEXT_PUBLIC_R2_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# 7. SEEDING (development only)
# ------------------------------------------------------------------------------
# Password for the sample agent created by `npm run db:seed`.
# If unset, a random password is generated and printed once.
SEED_AGENT_PASSWORD=""
